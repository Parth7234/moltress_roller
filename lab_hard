  draw_string_at(115, 100, "SCORE:", LGRAY);
  draw_score_5digits(160, 100, score, WHITE);
}

void show_game_over(void) {
  volatile int d;
  draw_on_both_buffers(draw_game_over_contents);
  for (d = 0; d < 3000000; d++)
    ;
}

/* ═══════════════════════════════════════════════════════════════
 * LEADERBOARD
 * ═══════════════════════════════════════════════════════════════ */
void update_leaderboard(int new_score) {
  int i, j;
  for (i = 0; i < LEADERBOARD_SIZE; i++) {
    if (new_score > leaderboard[i].score) {
      for (j = LEADERBOARD_SIZE - 1; j > i; j--)
        leaderboard[j] = leaderboard[j - 1];
      leaderboard[i].score = new_score;
      return;
    }
  }
}

void show_leaderboard_screen(void) {
  int i, y;
  short int clr;

  draw_string_at(100, 125, "LEADERBOARD", GOLD);
  draw_line(100, 134, 210, 134, DGRAY);

  for (i = 0; i < LEADERBOARD_SIZE; i++) {
    y = 140 + i * 14;
    clr = (i == 0) ? GOLD : WHITE;
    draw_char_at(108, y, '#', LGRAY);
    draw_digit_at(115, y, i + 1, LGRAY);
    draw_char_at(124, y, ':', LGRAY);
    draw_score_5digits(134, y, leaderboard[i].score, clr);
  }

  draw_string_at(90, 200, "PRESS KEY3 TO PLAY", LGRAY);
}
