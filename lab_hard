#define HAS_POWERUP 0x80
#define LEADERBOARD_SIZE 3
#define HEADER_BG 0x18E3

/* ───────── HEX segment encoding ───────── */
static const char seg7[] = {0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D,
                            0x7D, 0x07, 0x7F, 0x67, 0x77, 0x7C,
                            0x39, 0x5E, 0x79, 0x71, 0x40};

/* ───────── Memory-mapped I/O ───────── */
volatile int *LEDR_ptr = (int *)0xFF200000;
volatile int *KEY_ptr = (int *)0xFF200050;
volatile int *HEX3_0_ptr = (int *)0xFF200020;
volatile int *HEX5_4_ptr = (int *)0xFF200030;
volatile int pixel_buffer_start;

/* ───────── Brick row colours ───────── */
static const short brick_colors_top[BRICK_ROWS] = {0x549F, 0xCA49, 0x8C60,
                                                   0x2C69, 0xA817};
static const short brick_colors_bot[BRICK_ROWS] = {0x325C, 0x9A06, 0x6BE0,
                                                   0x1C25, 0x780F};

/* ───────── Types ───────── */
typedef enum { PU_NONE = 0, PU_WIDE, PU_MULTI } PowerUpType;

typedef struct {
  int x, y, dx, dy, radius;
  bool active, launched;
} Ball;

typedef struct {
  int x, y;
  PowerUpType type;
  bool active;
} PowerUp;

typedef struct {
  int x, width;
} Paddle;
typedef struct {
  int score;
} LeaderEntry;

/* ───────── State ───────── */
static int difficulty, speed_mul_num;
static int bricks[BRICK_ROWS][BRICK_COLS];
static Ball balls[MAX_BALLS], old_balls[MAX_BALLS];
static PowerUp powerups[MAX_POWERUPS], old_powerups[MAX_POWERUPS];
static Paddle paddle, old_paddle;
static int score, lives, level;
static bool game_running, ball_on_paddle;
static int wide_timer, frame_count;
