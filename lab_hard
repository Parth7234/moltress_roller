/* ═══════════════════════════════════════════════════════════════
 * UTILITIES
 * ═══════════════════════════════════════════════════════════════ */
void wait_for_vsync(void) {
  volatile int *ctrl = (int *)0xFF203020;
  *ctrl = 1;
  while ((*(ctrl + 3)) & 0x01)
    ;
}

unsigned int pseudo_rand(void) {
  rand_state = rand_state * 1103515245 + 12345;
  return (rand_state >> 16) & 0x7FFF;
}

int get_ball_speed(void) {
  int base = 320 + level * 40;
  int speed = (base * speed_mul_num) / 2;
  int cap = (640 * speed_mul_num) / 2;
  return (speed > cap) ? cap : speed;
}

void save_old_state(void) {
  int i;
  for (i = 0; i < MAX_BALLS; i++)
    old_balls[i] = balls[i];
  for (i = 0; i < MAX_POWERUPS; i++)
    old_powerups[i] = powerups[i];
  old_paddle = paddle;
}

/* Draw the full game scene (used to populate both buffers) */
void draw_full_scene(void) {
  clear_screen(DARKBG);
  draw_background();
  draw_bricks();
  draw_paddle_obj();
  draw_all_balls();
  draw_score_bar();
  update_hex_display();
}

/* Draw content on both buffers via vsync swap */
void draw_on_both_buffers(void (*draw_fn)(void)) {
  volatile int *pixel_ctrl = (int *)0xFF203020;
  draw_fn();
  wait_for_vsync();
  pixel_buffer_start = *(pixel_ctrl + 1);
  draw_fn();
  wait_for_vsync();
  pixel_buffer_start = *(pixel_ctrl + 1);
}

/* ═══════════════════════════════════════════════════════════════
 * START SCREEN
 * ═══════════════════════════════════════════════════════════════ */
static void draw_start_contents(void) {
  int i, y;
  short int clr;

  clear_screen(DARKBG);
  draw_string_at(100, 30, "SMASH HIT", GOLD);
  draw_line(95, 40, 210, 40, DGRAY);
  draw_string_at(75, 52, "SELECT DIFFICULTY", WHITE);
  draw_string_at(85, 72, "KEY0  EASY", GREEN);
  draw_string_at(85, 88, "KEY1  MEDIUM", YELLOW);
  draw_string_at(85, 104, "KEY2  HARD", RED);

  /* Leaderboard */
  draw_line(70, 125, 250, 125, DGRAY);
  draw_string_at(90, 132, "TOP SCORES", GOLD);
  for (i = 0; i < LEADERBOARD_SIZE; i++) {
    y = 148 + i * 14;
    clr = (i == 0) ? GOLD : WHITE;
    draw_char_at(100, y, '#', LGRAY);
    draw_digit_at(107, y, i + 1, LGRAY);
    draw_char_at(116, y, ':', LGRAY);
    draw_score_5digits(126, y, leaderboard[i].score, clr);
  }
  draw_string_at(55, 210, "PRESS A KEY TO BEGIN", LGRAY);
}

void show_start_screen(void) {
  int kv;
  draw_on_both_buffers(draw_start_contents);

  /* Wait for KEY0, KEY1, or KEY2 */
  while (1) {
    kv = *KEY_ptr;
    if (kv & 0x1) {
      difficulty = 0;
      speed_mul_num = 2;
      while (*KEY_ptr & 0x1)
        ;
      break;
    }
    if (kv & 0x2) {
      difficulty = 1;
      speed_mul_num = 3;
      while (*KEY_ptr & 0x2)
        ;
      break;
    }
    if (kv & 0x4) {
      difficulty = 2;
      speed_mul_num = 4;
      while (*KEY_ptr & 0x4)
        ;
      break;
    }
  }
}

/* ═══════════════════════════════════════════════════════════════
 * MAIN
 * ═══════════════════════════════════════════════════════════════ */
int main(void) {
  volatile int *pixel_ctrl = (int *)0xFF203020;
  int i;
  bool any_active;

  for (i = 0; i < LEADERBOARD_SIZE; i++)
    leaderboard[i].score = 0;

  /* Set up double buffering */
  *(pixel_ctrl + 1) = 0xC0000000;
  wait_for_vsync();
  pixel_buffer_start = *pixel_ctrl;
  clear_screen(DARKBG);
  *(pixel_ctrl + 1) = 0xC8000000;
  pixel_buffer_start = *(pixel_ctrl + 1);
  clear_screen(DARKBG);

  show_start_screen();
  init_game();

  while (1) {
    read_keys();

    if (!game_running)
      continue;

    frame_count++;

    /* Step 1: Erase old dynamic objects from back buffer */
    erase_old_balls();
    erase_old_powerups();

    /* Step 2: Save state, then update logic */
    save_old_state();
    update_balls();
    update_powerups();

    /* Power-up timer */
    if (wide_timer > 0 && --wide_timer == 0)
      paddle.width = PADDLE_W_DEFAULT;

    /* Next level? */
    if (all_bricks_destroyed())
      next_level();

    /* All balls lost? */
    {
      any_active = false;
      for (i = 0; i < MAX_BALLS; i++)
        if (balls[i].active)
          any_active = true;

      if (!any_active) {
        lives--;
        if (lives <= 0) {
          update_leaderboard(score);
          show_game_over();
          show_leaderboard_screen();
          while (1) {
            if (*KEY_ptr & 0x8) {
              while (*KEY_ptr & 0x8)
                ;
              break;
            }
          }
          show_start_screen();
          init_game();
          continue;
        }
        ball_on_paddle = true;
        init_ball(&balls[0], true);
      }
    }

    /* Step 3: Draw new state */
    draw_bricks();
    draw_paddle_obj();
    draw_all_balls();
    draw_powerups();
    draw_score_bar();
    update_hex_display();
    *LEDR_ptr = (1 << lives) - 1;

    /* Step 4: VSync swap */
    wait_for_vsync();
    pixel_buffer_start = *(pixel_ctrl + 1);
  }

  return 0;
}

/* ═══════════════════════════════════════════════════════════════
 * INIT / RESET
 * ═══════════════════════════════════════════════════════════════ */
void init_game(void) {
  volatile int *pixel_ctrl = (int *)0xFF203020;
  int i;

  score = 0;
  lives = 3;
  level = 1;
  game_running = true;
  ball_on_paddle = true;
  wide_timer = 0;
  frame_count = 0;

  paddle.width = PADDLE_W_DEFAULT;
  paddle.x = SCREEN_W / 2 - paddle.width / 2;

  for (i = 0; i < MAX_POWERUPS; i++)
    powerups[i].active = false;

  init_bricks();
  reset_balls();

  /* Draw on both buffers */
  draw_full_scene();
  wait_for_vsync();
  pixel_buffer_start = *(pixel_ctrl + 1);
  draw_full_scene();

  save_old_state();
}

void init_bricks(void) {
  int r, c, hp;
  for (r = 0; r < BRICK_ROWS; r++)
    for (c = 0; c < BRICK_COLS; c++) {
      hp = (level > 1 && pseudo_rand() % 5 == 0) ? 2 : 1;
      if (pseudo_rand() % 7 == 0)
        hp |= HAS_POWERUP;
      bricks[r][c] = hp;
    }
}

void init_ball(Ball *b, bool on_paddle_flag) {
  int speed;
  b->radius = BALL_R_DEFAULT;
  b->active = true;
  if (on_paddle_flag) {
    b->launched = false;
    b->x = (paddle.x + paddle.width / 2) << 8;
    b->y = (PADDLE_Y - b->radius - 1) << 8;
    b->dx = 0;
    b->dy = 0;
  } else {
    b->launched = true;
    speed = get_ball_speed();
    b->dx = (pseudo_rand() % 2 == 0) ? speed : -speed;
    b->dy = -speed;
  }
}

void reset_balls(void) {
  int i;
  for (i = 0; i < MAX_BALLS; i++) {
    balls[i].active = false;
    balls[i].launched = false;
  }
  init_ball(&balls[0], true);
}

/* ═══════════════════════════════════════════════════════════════
 * DRAWING PRIMITIVES
 * ═══════════════════════════════════════════════════════════════ */
void plot_pixel(int x, int y, short int color) {
  if (x < 0 || x >= SCREEN_W || y < 0 || y >= SCREEN_H)
    return;
  *(short int *)(pixel_buffer_start + (y << 10) + (x << 1)) = color;
}

void draw_box(int x, int y, int w, int h, short int color) {
  int dx, dy;
  for (dy = 0; dy < h; dy++)
    for (dx = 0; dx < w; dx++)
      plot_pixel(x + dx, y + dy, color);
}

void clear_screen(short int color) {
  int x, y;
  for (y = 0; y < SCREEN_H; y++)
    for (x = 0; x < SCREEN_W; x++)
      plot_pixel(x, y, color);
}

void swap_int(int *a, int *b) {
  int t = *a;
  *a = *b;
  *b = t;
}

void draw_line(int x0, int y0, int x1, int y1, short int color) {
  bool steep = abs(y1 - y0) > abs(x1 - x0);
  int deltax, deltay, error, ys, cy, cx;

  if (steep) {
    swap_int(&x0, &y0);
    swap_int(&x1, &y1);
  }
  if (x0 > x1) {
    swap_int(&x0, &x1);
    swap_int(&y0, &y1);
  }

  deltax = x1 - x0;
  deltay = abs(y1 - y0);
  error = -(deltax / 2);
  ys = (y0 < y1) ? 1 : -1;
  cy = y0;

  for (cx = x0; cx <= x1; cx++) {
    if (steep)
      plot_pixel(cy, cx, color);
    else
      plot_pixel(cx, cy, color);
    error += deltay;
    if (error >= 0) {
      cy += ys;
      error -= deltax;
    }
  }
}

void draw_circle(int cx, int cy, int r, short int color) {
  int dx, dy;
  for (dy = -r; dy <= r; dy++)
    for (dx = -r; dx <= r; dx++)
      if (dx * dx + dy * dy <= r * r)
        plot_pixel(cx + dx, cy + dy, color);
}

