/* ============================================================
 * SMASH HIT – Brick Breaker for DE-1 SoC (ARMv7)
 * ============================================================
 * Controls:
 * KEY0 – Move paddle RIGHT    KEY1 – Move paddle LEFT
 * KEY2 – Launch ball          KEY3 – Restart game
 *
 * Display:
 * VGA 320×240 (16-bit RGB565), HEX: score/level, LEDR: lives
 *
 * Features:
 * • 5×8 brick grid with gradient shading and power-ups
 * • Double-buffered VSync rendering (no flicker)
 * • Difficulty selection (Easy / Medium / Hard)
 * • Power-ups: W = Wide paddle, M = Multi-ball
 * • Top-3 leaderboard
 * ============================================================ */

#include <stdbool.h>
#include <stdio.h>
