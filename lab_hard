void draw_bricks(void) {
  int r, c, bx, by, hp, mx, my;
  short c_top, c_bot;

  for (r = 0; r < BRICK_ROWS; r++) {
    for (c = 0; c < BRICK_COLS; c++) {
      bx = BRICK_OFFSET_X + c * (BRICK_W + BRICK_GAP);
      by = BRICK_OFFSET_Y + r * (BRICK_H + BRICK_GAP);
      hp = bricks[r][c] & 0x7F;

      if (hp <= 0) {
        draw_box(bx, by, BRICK_W, BRICK_H, DARKBG);
        continue;
      }

      c_top = brick_colors_top[r];
      c_bot = brick_colors_bot[r];
      if (hp == 2) {
        c_top |= 0x2104;
        c_bot |= 0x1082;
      }

      draw_box(bx + 1, by + 1, BRICK_W - 2, BRICK_H / 2 - 1, c_top);
      draw_box(bx + 1, by + BRICK_H / 2, BRICK_W - 2, BRICK_H / 2 - 1, c_bot);

      /* Outline */
      draw_line(bx, by, bx + BRICK_W - 1, by, DARKBG);
      draw_line(bx, by + BRICK_H - 1, bx + BRICK_W - 1, by + BRICK_H - 1,
                DARKBG);
      draw_line(bx, by, bx, by + BRICK_H - 1, DARKBG);
      draw_line(bx + BRICK_W - 1, by, bx + BRICK_W - 1, by + BRICK_H - 1,
                DARKBG);

      /* Top highlight */
      draw_line(bx + 1, by + 1, bx + BRICK_W - 2, by + 1, c_top | 0x4208);

      /* Power-up indicator */
      if (bricks[r][c] & HAS_POWERUP) {
        mx = bx + BRICK_W / 2;
        my = by + BRICK_H / 2;
        draw_line(mx - 2, my, mx + 2, my, WHITE);
        draw_line(mx, my - 2, mx, my + 2, WHITE);
      }
    }
  }
}

void draw_paddle_obj(void) {
  int px = paddle.x, pw = paddle.width;
  draw_box(1, PADDLE_Y - 1, SCREEN_W - 2, PADDLE_H + 2, DARKBG);
  draw_box(px + 2, PADDLE_Y, pw - 4, PADDLE_H, WHITE);
  draw_box(px, PADDLE_Y + 1, 2, PADDLE_H - 2, LGRAY);
  draw_box(px + pw - 2, PADDLE_Y + 1, 2, PADDLE_H - 2, LGRAY);
  draw_line(px + 2, PADDLE_Y, px + pw - 3, PADDLE_Y, 0xFFFF);
  draw_line(px + 2, PADDLE_Y + PADDLE_H - 1, px + pw - 3,
            PADDLE_Y + PADDLE_H - 1, LGRAY);
  draw_line(px + pw / 2 - 3, PADDLE_Y + PADDLE_H / 2, px + pw / 2 + 3,
            PADDLE_Y + PADDLE_H / 2, DGRAY);
}

/* ═══════════════════════════════════════════════════════════════
 * BALL DRAWING / ERASING
 * ═══════════════════════════════════════════════════════════════ */
void draw_ball(Ball *b, short int color) {
  int bx, by;
  if (!b->active)
    return;
  bx = b->x >> 8;
  by = b->y >> 8;
  draw_circle(bx, by, b->radius, color);
  if (color != DARKBG)
    plot_pixel(bx - 1, by - 1, 0xFFFF);
}

void draw_all_balls(void) {
  int i;
  for (i = 0; i < MAX_BALLS; i++)
    if (balls[i].active)
      draw_ball(&balls[i], WHITE);
}

void erase_old_balls(void) {
  int i;
  for (i = 0; i < MAX_BALLS; i++)
    if (old_balls[i].active)
      draw_ball(&old_balls[i], DARKBG);
}

/* ═══════════════════════════════════════════════════════════════
 * BALL PHYSICS
 * ═══════════════════════════════════════════════════════════════ */
void update_balls(void) {
  int i;
  Ball *b;

  for (i = 0; i < MAX_BALLS; i++) {
    b = &balls[i];
    if (!b->active)
      continue;

    if (!b->launched) {
      b->x = (paddle.x + paddle.width / 2) << 8;
      b->y = (PADDLE_Y - b->radius - 1) << 8;
      continue;
    }

    b->x += b->dx;
    b->y += b->dy;
    handle_wall_collision(b);
    handle_paddle_collision(b);
    handle_brick_collision(b);

    if ((b->y >> 8) > SCREEN_H + 10)
      b->active = false;
  }
}

void handle_wall_collision(Ball *b) {
  int bx = b->x >> 8, by = b->y >> 8, r = b->radius;
  if (bx - r <= 1) {
    b->x = (1 + r) << 8;
    b->dx = -b->dx;
  }
  if (bx + r >= SCREEN_W - 2) {
    b->x = (SCREEN_W - 2 - r) << 8;
    b->dx = -b->dx;
  }
  if (by - r <= 21) {
    b->y = (21 + r) << 8;
    b->dy = -b->dy;
  }
}

void handle_paddle_collision(Ball *b) {
  int bx = b->x >> 8, by = b->y >> 8, r = b->radius;
  int speed, offset;

  if (b->dy > 0 && by + r >= PADDLE_Y && by + r <= PADDLE_Y + PADDLE_H &&
      bx >= paddle.x - 2 && bx <= paddle.x + paddle.width + 2) {
    b->y = (PADDLE_Y - r) << 8;
    speed = get_ball_speed();
    offset = bx - paddle.x - paddle.width / 2;
    b->dx = (offset * speed * 2) / paddle.width;
    if (b->dx > speed)
      b->dx = speed;
    if (b->dx < -speed)
      b->dx = -speed;
    b->dy = -speed;
  }
}

void handle_brick_collision(Ball *b) {
  int bx = b->x >> 8, by = b->y >> 8, r = b->radius;
  int row, col, hp, brick_x, brick_y, ol, oR, ot, ob, minX, minY, flags;
  PowerUpType pt;

  for (row = 0; row < BRICK_ROWS; row++) {
    for (col = 0; col < BRICK_COLS; col++) {
      hp = bricks[row][col] & 0x7F;
      if (hp <= 0)
        continue;

      brick_x = BRICK_OFFSET_X + col * (BRICK_W + BRICK_GAP);
      brick_y = BRICK_OFFSET_Y + row * (BRICK_H + BRICK_GAP);

      if (bx + r >= brick_x && bx - r <= brick_x + BRICK_W &&
          by + r >= brick_y && by - r <= brick_y + BRICK_H) {
        ol = (bx + r) - brick_x;
        oR = (brick_x + BRICK_W) - (bx - r);
        ot = (by + r) - brick_y;
        ob = (brick_y + BRICK_H) - (by - r);
        minX = (ol < oR) ? ol : oR;
        minY = (ot < ob) ? ot : ob;

        if (minX < minY)
          b->dx = -b->dx;
        else
          b->dy = -b->dy;

        flags = bricks[row][col] & HAS_POWERUP;
        hp--;
        if (hp <= 0) {
          bricks[row][col] = 0;
          score += (BRICK_ROWS - row) * 10;
          if (flags) {
            pt = (PowerUpType)((pseudo_rand() % 2) + 1);
            spawn_powerup(brick_x + BRICK_W / 2, brick_y + BRICK_H, pt);
          }
        } else {
          bricks[row][col] = hp | flags;
        }
        return;
      }
    }
  }
}

/* ═══════════════════════════════════════════════════════════════
 * POWER-UPS
 * ═══════════════════════════════════════════════════════════════ */
void spawn_powerup(int bx, int by, PowerUpType type) {
  int i;
  for (i = 0; i < MAX_POWERUPS; i++) {
    if (!powerups[i].active) {
      powerups[i].x = bx - POWERUP_W / 2;
      powerups[i].y = by;
      powerups[i].type = type;
      powerups[i].active = true;
      return;
    }
  }
}

void update_powerups(void) {
  int i;
  for (i = 0; i < MAX_POWERUPS; i++) {
    if (!powerups[i].active)
      continue;
    powerups[i].y += POWERUP_SPEED;
    if (powerups[i].y + POWERUP_H >= PADDLE_Y &&
        powerups[i].y <= PADDLE_Y + PADDLE_H &&
        powerups[i].x + POWERUP_W >= paddle.x &&
        powerups[i].x <= paddle.x + paddle.width) {
      apply_powerup(powerups[i].type);
      powerups[i].active = false;
    } else if (powerups[i].y > SCREEN_H) {
      powerups[i].active = false;
    }
  }
}

void draw_powerups(void) {
  int i;
  short int color;
  char label;

  for (i = 0; i < MAX_POWERUPS; i++) {
    if (!powerups[i].active)
      continue;
    color = (powerups[i].type == PU_WIDE) ? GREEN : CYAN;
    label = (powerups[i].type == PU_WIDE) ? 'W' : 'M';
    draw_box(powerups[i].x, powerups[i].y, POWERUP_W, POWERUP_H, color);
    draw_line(powerups[i].x, powerups[i].y, powerups[i].x + POWERUP_W - 1,
              powerups[i].y, BLACK);
    draw_line(powerups[i].x, powerups[i].y + POWERUP_H - 1,
              powerups[i].x + POWERUP_W - 1, powerups[i].y + POWERUP_H - 1,
              BLACK);
    draw_char_at(powerups[i].x + 3, powerups[i].y + 1, label, BLACK);
  }
}

void erase_old_powerups(void) {
  int i;
  for (i = 0; i < MAX_POWERUPS; i++)
    if (old_powerups[i].active)
      draw_box(old_powerups[i].x, old_powerups[i].y, POWERUP_W, POWERUP_H,
               DARKBG);
}

void apply_powerup(PowerUpType type) {
  int i, added, speed;

  if (type == PU_WIDE) {
    paddle.width = PADDLE_W_WIDE;
    wide_timer = 500;
  } else if (type == PU_MULTI) {
    added = 0;
    for (i = 1; i < MAX_BALLS && added < 2; i++) {
      if (!balls[i].active) {
        balls[i].active = true;
        balls[i].launched = true;
        balls[i].radius = balls[0].radius;
        balls[i].x = balls[0].x;
        balls[i].y = balls[0].y;
        speed = get_ball_speed();
        balls[i].dx = (added == 0) ? -speed : speed;
        balls[i].dy = -speed;
        added++;
      }
    }
  }
}

/* ═══════════════════════════════════════════════════════════════
 * INPUT
 * ═══════════════════════════════════════════════════════════════ */
static int prev_key = 0;

void read_keys(void) {
  int kv = *KEY_ptr;
  int key_pressed = kv & ~prev_key;
  int speed;
  prev_key = kv;

  /* KEY0 – Move paddle RIGHT */
  if (key_pressed & 0x1) {
    paddle.x += paddle.width;
    if (paddle.x + paddle.width > SCREEN_W - 2)
      paddle.x = SCREEN_W - 2 - paddle.width;
  }

  /* KEY1 – Move paddle LEFT */
  if (key_pressed & 0x2) {
    paddle.x -= paddle.width;
    if (paddle.x < 2)
      paddle.x = 2;
  }

  /* KEY2 – Launch ball */
  if (key_pressed & 0x4) {
    if (ball_on_paddle) {
      speed = get_ball_speed();
      balls[0].launched = true;
      balls[0].dx = (pseudo_rand() % 2 == 0) ? (speed / 2) : -(speed / 2);
      balls[0].dy = -speed;
      ball_on_paddle = false;
    }
  }

  /* KEY3 – Restart */
  if (key_pressed & 0x8) {
    update_leaderboard(score);
    show_start_screen();
    init_game();
  }
}

/* ═══════════════════════════════════════════════════════════════
 * HEX DISPLAY
 * ═══════════════════════════════════════════════════════════════ */
void update_hex_display(void) {
  *HEX3_0_ptr = seg7[level % 10] | (seg7[(level / 10) % 10] << 8) |
                (seg7[16] << 16) | (seg7[score % 10] << 24);
  *HEX5_4_ptr = seg7[(score / 10) % 10] | (seg7[(score / 100) % 10] << 8);
}

/* ═══════════════════════════════════════════════════════════════
 * LEVEL / GAME-OVER
 * ═══════════════════════════════════════════════════════════════ */
bool all_bricks_destroyed(void) {
  int r, c;
  for (r = 0; r < BRICK_ROWS; r++)
    for (c = 0; c < BRICK_COLS; c++)
      if ((bricks[r][c] & 0x7F) > 0)
        return false;
  return true;
}

void next_level(void) {
  volatile int *pixel_ctrl = (int *)0xFF203020;
  int i, buf;
  volatile int d;

  level++;
  ball_on_paddle = true;
  wide_timer = 0;
  paddle.width = PADDLE_W_DEFAULT;

  for (i = 0; i < MAX_POWERUPS; i++)
    powerups[i].active = false;

  init_bricks();
  reset_balls();

  /* Level announcement on both buffers */
  for (buf = 0; buf < 2; buf++) {
    clear_screen(DARKBG);
    draw_background();
    draw_string_at(120, 110, "LEVEL", GOLD);
    draw_digit_at(158, 110, level % 10, GOLD);
    if (level >= 10)
      draw_digit_at(152, 110, (level / 10) % 10, GOLD);
    wait_for_vsync();
    pixel_buffer_start = *(pixel_ctrl + 1);
  }

  for (d = 0; d < 2000000; d++)
    ;

  /* Game scene on both buffers */
  draw_full_scene();
  wait_for_vsync();
  pixel_buffer_start = *(pixel_ctrl + 1);
  draw_full_scene();

  save_old_state();
}

