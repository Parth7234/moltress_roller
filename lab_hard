void draw_digit_at(int x, int y, int digit, short int color) {
  int row, col;
  if (digit < 0 || digit > 9)
    return;
  for (row = 0; row < 7; row++)
    for (col = 0; col < 5; col++)
      if (font5x7_digits[digit][row] & (0x10 >> col))
        plot_pixel(x + col, y + row, color);
}

void draw_char_at(int x, int y, char c, short int color) {
  int idx = -1;
  int row, col;

  if (c >= '0' && c <= '9') {
    draw_digit_at(x, y, c - '0', color);
    return;
  }
  if (c == ' ')
    return;
  if (c == ':') {
    plot_pixel(x + 2, y + 2, color);
    plot_pixel(x + 2, y + 5, color);
    return;
  }
  if (c == '-') {
    draw_line(x + 1, y + 3, x + 3, y + 3, color);
    return;
  }
  if (c == '#') {
    draw_line(x + 1, y + 1, x + 1, y + 5, color);
    draw_line(x + 3, y + 1, x + 3, y + 5, color);
    draw_line(x, y + 2, x + 4, y + 2, color);
    draw_line(x, y + 4, x + 4, y + 4, color);
    return;
  }
  
  if (c >= 'A' && c <= 'Z')
    idx = c - 'A';
  else if (c >= 'a' && c <= 'z')
    idx = c - 'a';
  if (idx < 0 || idx > 25)
    return;

  for (row = 0; row < 7; row++)
    for (col = 0; col < 5; col++)
      if (font5x7_letters[idx][row] & (0x10 >> col))
        plot_pixel(x + col, y + row, color);
}

void draw_string_at(int x, int y, const char *s, short int color) {
  while (*s) {
    draw_char_at(x, y, *s, color);
    x += 6;
    s++;
  }
}

/* Draw a 5-digit score at (x,y) */
void draw_score_5digits(int x, int y, int val, short int color) {
  int div;
  for (div = 10000; div >= 1; div /= 10) {
    draw_digit_at(x, y, (val / div) % 10, color);
    x += 7;
  }
}

